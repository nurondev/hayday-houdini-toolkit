# hayday-houdini-toolkit
#
# Keep source code, scripts, documentation, dependency lockfiles, and
# reproducible project configuration in Git. Exclude generated output,
# machine-local configuration, secrets, and proprietary game artifacts.

# Operating-system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
NUL

# Editors and IDEs
.idea/
.fleet/
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.swp
*.swo
*~

# Local agent/tool state (AGENTS.md remains trackable)
.agents/
.codex/

# Secrets, signing material, and machine-local configuration
.env
.env.*
!.env.example
!.env.*.example
local.properties
keystore.properties
signing.properties
credentials.json
config.local.*
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

